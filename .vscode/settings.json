{
    // NOVAthesis 8.x: build through latexmk *without* -pdf/-lualatex flags, so the
    // template's MSc_thesis/latexmkrc decides the engine (LuaLaTeX) and runs
    // biber and bib2gls (needs Java on PATH) as many times as needed.
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk-novathesis",
            "command": "latexmk",
            "args": [
                "-shell-escape",
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "%DOCFILE%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk (NOVAthesis 8)",
            "tools": ["latexmk-novathesis"]
        }
    ],
    "latex-workshop.latex.recipe.default": "first",
    // Clean through latexmkrc too, so it empties AUXDIR (including latexmk's
    // record of a failed run) instead of the wrong folder.
    "latex-workshop.latex.clean.method": "command",
    "latex-workshop.latex.clean.command": "latexmk",
    "latex-workshop.latex.clean.args": ["-c", "%TEX%"],
    "cSpell.words": [
        "chktex",
        "eNB",
        "esim",
        "gNB",
        "iperf",
        "Moto",
        "Oliveira",
        "phdplan",
        "PLMN",
        "pucch",
        "pusch",
        "RAN",
        "ulisboa",
        "UPF",
        "Wireshark"
    ]
}